generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  name     String
  password String
  rooms    Room[] @relation("UserRooms")
}

model Room {
  id                   String      @id @default(uuid())
  name                 String
  ownerId              String
  owner                User        @relation("UserRooms", fields: [ownerId], references: [id])
  players              Player[]    @relation("RoomPlayers")
  PlayerLimit          Int         @default(10)
  PlayersCanEditPoints Boolean     @default(false)
  PlayersCanEditName   Boolean     @default(false)
  EmojisEnabled        Boolean     @default(false)
  EmojiLimit           Int         @default(10)
  EmojiCooldown        Int         @default(5)
  emojis               RoomEmoji[]
  auctions             Auction[]
}

model Player {
  id              String       @id @default(uuid())
  name            String
  avatar          String?
  roomId          String
  room            Room         @relation("RoomPlayers", fields: [roomId], references: [id], onDelete: Cascade)
  points          Int          @default(0)
  emojis          RoomEmoji[]
  leadingAuctions Auction[]    @relation("AuctionLeader")
  bids            AuctionBid[]
}

model RoomEmoji {
  id        String   @id @default(uuid())
  roomId    String
  playerId  String
  emoji     String
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([playerId, createdAt])
  @@index([createdAt])
}

enum AuctionStatus {
  RUNNING
  FINISHED
  CANCELLED
}

model Auction {
  id              String        @id @default(uuid())
  roomId          String
  item            String?
  startingBid     Int
  minIncrement    Int           @default(1)
  // duração inicial e tempo mínimo restante após um lance (segundos)
  durationSeconds Int           @default(30)
  bidResetSeconds Int           @default(10)
  status          AuctionStatus @default(RUNNING)
  // contagem antes de liberar os lances, para a interface chegar aos jogadores
  startsAt        DateTime      @default(now())
  endsAt          DateTime
  // lance vencedor no momento; os pontos dele ficam reservados (já descontados do jogador)
  currentBid      Int?
  leaderId        String?
  leaderName      String?
  createdAt       DateTime      @default(now())
  finishedAt      DateTime?
  room            Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  leader          Player?       @relation("AuctionLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  bids            AuctionBid[]

  @@index([roomId, createdAt])
}

model AuctionBid {
  id         String   @id @default(uuid())
  auctionId  String
  playerId   String?
  playerName String
  amount     Int
  createdAt  DateTime @default(now())
  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  player     Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([auctionId, createdAt])
}
