generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  name     String
  password String
  rooms    Room[] @relation("UserRooms")
}

model Room {
  id                   String   @id @default(uuid())
  name                 String
  ownerId              String
  owner                User     @relation("UserRooms", fields: [ownerId], references: [id])
  players              Player[] @relation("RoomPlayers")
  PlayerLimit          Int      @default(10)
  PlayersCanEditPoints Boolean  @default(false)
  PlayersCanEditName   Boolean  @default(false)
  EmojisEnabled        Boolean  @default(false)
  EmojiLimit           Int      @default(10)
  emojiSessions        EmojiSession[]
}

model Player {
  id     String  @id @default(uuid())
  name   String
  avatar String?
  roomId String
  room   Room    @relation("RoomPlayers", fields: [roomId], references: [id], onDelete: Cascade)
  points Int     @default(0)
  emojiSessions EmojiSession[]
}

model EmojiSession {
  id        String        @id @default(uuid())
  roomId    String
  playerId  String
  sentCount Int           @default(0)
  createdAt DateTime      @default(now())
  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player    Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  reactions RoomEmoji[]

  @@index([roomId, createdAt])
  @@index([createdAt])
}

model RoomEmoji {
  id        String       @id @default(uuid())
  sessionId String
  emoji     String
  createdAt DateTime     @default(now())
  session   EmojiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([createdAt])
}
