generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  name     String
  password String
  rooms    Room[] @relation("UserRooms")
}

model Room {
  id                   String   @id @default(uuid())
  name                 String
  ownerId              String
  owner                User     @relation("UserRooms", fields: [ownerId], references: [id])
  players              Player[] @relation("RoomPlayers")
  PlayerLimit          Int      @default(10)
  PlayersCanEditPoints Boolean  @default(false)
  PlayersCanEditName   Boolean  @default(false)
}

model Player {
  id     String  @id @default(uuid())
  name   String
  avatar String?
  roomId String
  room   Room    @relation("RoomPlayers", fields: [roomId], references: [id])
  points Int     @default(0)
}
